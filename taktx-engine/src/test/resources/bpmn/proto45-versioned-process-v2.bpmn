<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_proto45_versioned_v2"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="proto45-versioned-process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_v2_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_v2_start" sourceRef="StartEvent_1" targetRef="ServiceTask_v2"/>
    <bpmn:serviceTask id="ServiceTask_v2" name="Current worker">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="proto45-version-task-v2" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_v2_start</bpmn:incoming>
      <bpmn:outgoing>Flow_v2_task</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_v2_task" sourceRef="ServiceTask_v2" targetRef="Task_v2"/>
    <bpmn:task id="Task_v2" name="Current follow-up task">
      <bpmn:incoming>Flow_v2_task</bpmn:incoming>
      <bpmn:outgoing>Flow_v2_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_v2_end" sourceRef="Task_v2" targetRef="EndEvent_v2"/>
    <bpmn:endEvent id="EndEvent_v2">
      <bpmn:incoming>Flow_v2_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>

