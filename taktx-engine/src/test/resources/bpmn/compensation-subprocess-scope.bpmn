      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-a_di" bpmnElement="task-a">
        <dc:Bounds x="240" y="95" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="undo-task-a_di" bpmnElement="undo-task-a">
        <dc:Bounds x="240" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subprocess_di" bpmnElement="subprocess" isExpanded="true">
        <dc:Bounds x="400" y="50" width="420" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start-sub_di" bpmnElement="start-sub">
