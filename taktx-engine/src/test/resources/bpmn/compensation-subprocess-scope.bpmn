      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task-b_di" bpmnElement="task-b">
        <dc:Bounds x="520" y="95" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="throw-inside-sub_di" bpmnElement="throw-inside-sub">
        <dc:Bounds x="682" y="117" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="662" y="160" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-sub_di" bpmnElement="end-sub">
        <dc:Bounds x="762" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="undo-task-b_di" bpmnElement="undo-task-b">
        <dc:Bounds x="520" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="assoc-b_di" bpmnElement="assoc-b">
        <di:waypoint x="570" y="193" />
        <di:waypoint x="570" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="compensate-task-b_di" bpmnElement="compensate-task-b">
        <dc:Bounds x="552" y="157" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-sub-to-task-b_di" bpmnElement="flow-start-sub-to-task-b">
        <di:waypoint x="468" y="135" />
        <di:waypoint x="520" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-task-b-to-throw_di" bpmnElement="flow-task-b-to-throw">
        <di:waypoint x="620" y="135" />
        <di:waypoint x="682" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-throw-to-end-sub_di" bpmnElement="flow-throw-to-end-sub">
        <di:waypoint x="718" y="135" />
        <di:waypoint x="762" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="882" y="117" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="compensate-task-a_di" bpmnElement="compensate-task-a">
        <dc:Bounds x="272" y="157" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-start-to-task-a_di" bpmnElement="flow-start-to-task-a">
        <di:waypoint x="188" y="135" />
        <di:waypoint x="240" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-task-a-to-sub_di" bpmnElement="flow-task-a-to-sub">
        <di:waypoint x="340" y="135" />
        <di:waypoint x="400" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-sub-to-end_di" bpmnElement="flow-sub-to-end">
        <di:waypoint x="820" y="135" />
        <di:waypoint x="882" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="assoc-a_di" bpmnElement="assoc-a">
